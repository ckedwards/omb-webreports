#!/usr/bin/env node
// webdata-info: where omb-webreports lives on this machine and whether it's
// healthy. Agents run this first: SITE, REPORTS, JOBS, DATA and DOCS below are
// what the docs and skills mean by SITE/..., REPORTS/... and so on.
//
//   webdata-info                          locations, URL, versions, service status
//   webdata-info --site|--reports|--jobs|--data|--docs   just that location

import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';

import os from 'node:os';

import { ROOT, SITE_URL, OMB_DATA_DIR, NODE_MODULES_DIR, LISTEN_IP, DUCKDB_WASM_VERSION, OMB_URL, CONFIG_FILE, INSTALLED,
  REPORTS_DIR, JOBS_DIR, PUBLISHED_DIR, PLATFORM_DIR, DATA_DIR } from './_config.mjs';
import { SESSION_FILE } from './_skills.mjs';

const just = { '--site': SITE_URL, '--reports': REPORTS_DIR, '--jobs': JOBS_DIR, '--data': PUBLISHED_DIR, '--docs': ROOT, '--root': ROOT };
const arg = process.argv[2];
if (arg in just) { console.log(just[arg]); process.exit(0); }

// Where the running install came from (admin/install.sh records it).
function installedFrom() {
  let i;
  try { i = JSON.parse(fs.readFileSync(path.join(path.dirname(CONFIG_FILE), 'installed.json'), 'utf8')); } catch { return INSTALLED ? 'unknown' : `not installed (no ${CONFIG_FILE}): run admin/install.sh`; }
  const what = `${i.source}${i.commit ? ` @ ${i.commit.slice(0, 12)}${i.ref ? ` (${i.ref})` : ''}` : ''}, ${i.at}`;
  return i.unsafe ? `${what}  UNSAFE: a development checkout, writable by ${i.source_owner}` : what;
}

const version = (mod) => { try { return JSON.parse(fs.readFileSync(path.join(NODE_MODULES_DIR, mod, 'package.json'), 'utf8')).version; } catch { return 'MISSING'; } };
// Browser vs server DuckDB, from admin/duckdb-wasm.mjs's lookup cache (no network here).
function duckdbLine() {
  const api = version('@duckdb/node-api');
  const server = api === 'MISSING' ? null : `v${api.split('-')[0]}`;
  let browser = null;
  const userCache = path.join(process.env.XDG_CACHE_HOME || path.join(os.homedir(), '.cache'), 'omb-webreports', 'duckdb-versions.json');
  for (const f of ['/var/cache/omb-webreports/duckdb-versions.json', userCache]) {
    try { browser = JSON.parse(fs.readFileSync(f, 'utf8')).wasm?.[DUCKDB_WASM_VERSION] ?? null; } catch {}
    if (browser) break;
  }
  const verdict = !browser ? 'not checked yet: admin/openmausbot-upgrade.sh --check (in the source clone)'
    : browser === server ? `DuckDB ${browser}, same as the server`
    : `DuckDB ${browser}, MISMATCH with the server's ${server}: run sudo admin/openmausbot-upgrade.sh (in the source clone)`;
  return `${DUCKDB_WASM_VERSION} (${verdict})`;
}
// Does OpenMausBot refuse a local request without a login? (OMB_LOOPBACK_TRUST=service)
async function isolationLine() {
  let code;
  try { code = (await fetch(`${OMB_URL}/api/bot-presets`, { signal: AbortSignal.timeout(3000) })).status; } catch { return 'unknown (OpenMausBot not reachable)'; }
  const session = fs.existsSync(SESSION_FILE) ? 'webdata-skills session present' : 'NO webdata-skills session: sudo webdata-skills login';
  if (code === 401 || code === 403) return `on: local requests without a login are refused; ${session}`;
  return `off: any program on this machine, bots' shells included, can administer OpenMausBot (OMB_LOOPBACK_TRUST in config.env)`;
}
const active = (unit) => { try { return execFileSync('systemctl', ['is-active', unit], { encoding: 'utf8' }).trim(); } catch (e) { return (e.stdout || 'unknown').trim(); } };

console.log(`omb-webreports
  SITE     ${SITE_URL}   the address people open
  REPORTS  ${REPORTS_DIR}   your reports, one directory each → SITE/reports/<slug>/
  JOBS     ${JOBS_DIR}   scheduled data jobs, one directory each
  DATA     ${PUBLISHED_DIR}   published databases + catalog.json (generated by webdata-sync)
  DOCS     ${ROOT}   read-only: READ_FIRST.md, DESIGN.md, examples/, the tools

  READ_FIRST.md (agents start here)   ${path.join(ROOT, 'READ_FIRST.md')}
  DESIGN.md (design system)           ${path.join(ROOT, 'DESIGN.md')}
  design gallery (copy from it)       ${path.join(PLATFORM_DIR, 'reports', '_gallery', 'index.html')}   → ${SITE_URL}/reports/_gallery/
  example report                      ${path.join(ROOT, 'examples', 'reports', 'blue-jays-2026', 'index.html')}
  OpenMausBot data                    ${OMB_DATA_DIR}
  Apache listens on                   ${LISTEN_IP}
  settings                            ${CONFIG_FILE}
  installed from                      ${installedFrom()}`);
console.log(`
versions
  openmausbot        ${version('openmausbot')}
  @duckdb/node-api   ${version('@duckdb/node-api')}
  browser DuckDB     ${duckdbLine()}
  @resvg/resvg-js    ${version('@resvg/resvg-js')}
  node               ${process.versions.node}

services
${['openmausbot', 'apache2', 'webdata-sync', 'webdata-jobs'].map((u) => `  ${u.padEnd(18)} ${active(u)}`).join('\n')}

OpenMausBot isolation
  ${await isolationLine()}`);
