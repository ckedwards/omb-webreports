#!/usr/bin/env node
// webdata-job: scheduled scripts that refresh bots' DuckDB tables.
//
// A job is <data>/jobs/<name>/ (JOBS in webdata-info) with:
//   job.json   bot, cron schedule + timezone, tables to write, enabled flag
//   run.py | run.mjs | run.sh | run   the script (any one; or "command" in job.json)
//   .env       optional KEY=value secrets for the script (chmod 600)
//
// The script only collects: it writes one file per declared table into
// $WEBDATA_OUT (<table>.json | .ndjson | .csv | .parquet) and exits 0. This
// runner then validates every table and applies them to the bot's database in
// one short transaction, waiting while OpenMausBot holds the file (it keeps a
// bot's database open for 10 minutes after use; DuckDB allows one writer).
// A failed script, a missing table or a failed check writes nothing.
//
//   webdata-job list                       jobs, schedule, last/next run
//   webdata-job new <name> --bot <bot> --table <t>[:mode[:key,key]] ...
//                   --schedule "<cron>" [--tz <IANA>] [--description "..."]
//   webdata-job run <name> [--dry-run]     run now (dry run: collect + validate only)
//   webdata-job logs <name> [--all]        last run's log (or list of runs)
//   webdata-job enable|disable <name>
//   webdata-job show <name>                job.json, validation, next 5 runs
//   webdata-job notify-test <name>         ask webdata-notify to send a test alert for the job
//   webdata-job daemon                     the scheduler (webdata-jobs.service)
//
// Scheduled runs start a fixed 0-50 s into their minute (from the job's name),
// so jobs due in the same minute don't all start at once.
//
// Failure alerts: "notify_failure": "<bot>" in job.json. The runner records
// each failure's kind (the script exits 75 when its source can't be reached:
// temporary; anything else: broken) and, after a failed scheduled run, checks
// this machine's internet connection and the job's sources. webdata-notify
// (a root service: it holds the webhooks, bots can't see them) reads that and
// starts a task in the bot when it's worth one (bin/_notify.mjs).
//
// Table modes: replace (default; whole table each run), append (add rows),
// upsert (replace rows with the same key, add new ones; needs a key).

import { spawn } from 'node:child_process';
import crypto from 'node:crypto';
import dns from 'node:dns/promises';
import fs from 'node:fs';
import { createRequire } from 'node:module';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

import { DATA_DIR, JOBS_DIR, STATE_DIR, PUBLISHED_DIR, OMB_DATA_DIR, NODE_MODULES_DIR } from './_config.mjs';
import { TEMPFAIL, NOTIFY_STATUS, HEARTBEAT_MS, alertSettings, fmtDuration } from './_notify.mjs';
// Overridable so tests never share a folder with the live webdata-jobs service.
const JOBS = process.env.WEBDATA_JOBS_DIR || JOBS_DIR;
const STATE = process.env.WEBDATA_JOBS_STATE || path.join(STATE_DIR, 'jobs');
const CATALOG = path.join(PUBLISHED_DIR, 'catalog.json');
const rel = (p) => path.relative(DATA_DIR, p);
const OMB = OMB_DATA_DIR;
// The exact binding OpenMausBot uses, so the file format never drifts.
const DUCKDB = path.join(NODE_MODULES_DIR, '@duckdb', 'node-api', 'lib', 'index.js');

const NAME = /^[a-z0-9][a-z0-9-]{0,62}$/;
const TABLE = /^[a-z_][a-z0-9_]{0,62}$/;
const MODES = new Set(['replace', 'append', 'upsert']);
const FORMATS = ['parquet', 'ndjson', 'jsonl', 'json', 'csv'];
const KEEP_LOGS = 30;
const LOCK_RETRY_MS = 15_000;

const readJSON = (f, fallback) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')); } catch { return fallback; } };
const writeJSON = (f, v) => { const t = `${f}.tmp-${process.pid}`; fs.writeFileSync(t, JSON.stringify(v, null, 2) + '\n'); fs.renameSync(t, f); };
const q = (s) => `"${String(s).replace(/"/g, '""')}"`;
const lit = (s) => `'${String(s).replace(/'/g, "''")}'`;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const stamp = () => new Date().toISOString();
const ago = (iso) => {
  if (!iso) return 'never';
  const m = Math.round((Date.now() - Date.parse(iso)) / 60000);
  return m < 1 ? 'just now' : m < 60 ? `${m}m ago` : m < 2880 ? `${Math.round(m / 60)}h ago` : `${Math.round(m / 1440)}d ago`;
};

// ---------------------------------------------------------------- cron

const ALIASES = { '@hourly': '0 * * * *', '@daily': '0 0 * * *', '@midnight': '0 0 * * *', '@weekly': '0 0 * * 0', '@monthly': '0 0 1 * *', '@yearly': '0 0 1 1 *' };
const NAMES = {
  month: ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'],
  dow: ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'],
};

function parseField(text, min, max, names) {
  const set = new Set();
  for (const part of text.toLowerCase().split(',')) {
    const m = part.match(/^(\*|[a-z0-9]+(?:-[a-z0-9]+)?)(?:\/(\d+))?$/);
    if (!m) throw new Error(`bad cron field "${text}"`);
    const val = (v) => {
      const i = names ? names.indexOf(v) : -1;
      const n = i >= 0 ? i + (min === 1 ? 1 : 0) : Number(v);
      if (!Number.isInteger(n) || n < min || n > max) throw new Error(`"${v}" out of range in "${text}"`);
      return n;
    };
    let [lo, hi] = m[1] === '*' ? [min, max] : m[1].split('-').map(val);
    if (hi == null) hi = m[2] ? max : lo;
    const step = m[2] ? Number(m[2]) : 1;
    if (step < 1 || lo > hi) throw new Error(`bad range in "${text}"`);
    for (let v = lo; v <= hi; v += step) set.add(v);
  }
  return set;
}

function parseCron(expr) {
  const fields = (ALIASES[expr.trim()] || expr).trim().split(/\s+/);
  if (fields.length !== 5) throw new Error(`cron needs 5 fields (minute hour day month weekday), got "${expr}"`);
  const dow = parseField(fields[4], 0, 7, NAMES.dow);
  if (dow.has(7)) dow.add(0);
  return {
    minute: parseField(fields[0], 0, 59), hour: parseField(fields[1], 0, 23),
    dom: parseField(fields[2], 1, 31), month: parseField(fields[3], 1, 12, NAMES.month), dow,
    domAny: fields[2] === '*', dowAny: fields[4] === '*',
  };
}

const formatters = new Map();
function partsIn(date, tz) {
  let f = formatters.get(tz);
  if (!f) {
    f = new Intl.DateTimeFormat('en-US', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: 'numeric',
      day: 'numeric', hour: 'numeric', minute: 'numeric', weekday: 'short' });
    formatters.set(tz, f);
  }
  const p = Object.fromEntries(f.formatToParts(date).map((x) => [x.type, x.value]));
  return { minute: +p.minute, hour: +p.hour, dom: +p.day, month: +p.month, dow: NAMES.dow.indexOf(p.weekday.toLowerCase().slice(0, 3)) };
}

function cronMatches(cron, date, tz) {
  const p = partsIn(date, tz);
  if (!cron.minute.has(p.minute) || !cron.hour.has(p.hour) || !cron.month.has(p.month)) return false;
  // Vixie cron: when both day fields are restricted, either may match.
  if (!cron.domAny && !cron.dowAny) return cron.dom.has(p.dom) || cron.dow.has(p.dow);
  return cron.dom.has(p.dom) && cron.dow.has(p.dow);
}

function nextRuns(cron, tz, count = 1, from = new Date()) {
  const out = [];
  const t = new Date(Math.floor(from.getTime() / 60000) * 60000 + 60000);
  for (let i = 0; i < 60 * 24 * 400 && out.length < count; i++, t.setTime(t.getTime() + 60000)) {
    if (cronMatches(cron, t, tz)) out.push(new Date(t));
  }
  return out;
}

// Jobs due in the same minute would otherwise all start at once, and with them
// any headless Chrome they launch. Each job instead starts a fixed number of
// seconds into its scheduled minute, derived from its name: spread out, but
// the same on every run and across restarts.
const START_SPREAD_S = 50;
const startOffset = (name) => crypto.createHash('sha1').update(name).digest().readUInt32BE(0) % (START_SPREAD_S + 1);

const fmtTime = (d, tz) => d.toLocaleString('en-CA', { timeZone: tz, dateStyle: 'short', timeStyle: 'short', hourCycle: 'h23' }) + ` ${tz}`;

// ---------------------------------------------------------------- jobs

function listBots() {
  const bots = readJSON(path.join(OMB, 'bots.json'), []);
  return (Array.isArray(bots) ? bots : Object.values(bots)).filter((b) => b?.id);
}

function resolveBot(nameOrId) {
  const want = String(nameOrId ?? '').toLowerCase();
  const bot = listBots().find((b) => b.id === nameOrId || String(b.name).toLowerCase() === want);
  if (!bot) throw new Error(`no bot "${nameOrId}" (bots: ${listBots().map((b) => b.name).join(', ')})`);
  const snapshot = (readJSON(CATALOG, { databases: [] }).databases || []).find((d) => d.source?.id === bot.id);
  return {
    id: bot.id, name: bot.name,
    db: path.join(OMB, 'bots', bot.id, 'data.duckdb'),
    snapshot: snapshot ? path.join(PUBLISHED_DIR, path.basename(snapshot.url)) : null,
    snapshotName: snapshot?.name ?? null,
  };
}

/** Load and validate one job. Throws with every problem listed. */
function loadJob(name) {
  if (!NAME.test(name)) throw new Error(`job name "${name}" must be lowercase-kebab-case`);
  const dir = path.join(JOBS, name);
  const file = path.join(dir, 'job.json');
  if (!fs.existsSync(file)) throw new Error(`no ${rel(file)}`);
  let raw;
  try { raw = JSON.parse(fs.readFileSync(file, 'utf8')); } catch (e) { throw new Error(`jobs/${name}/job.json: ${e.message}`); }
  const problems = [];
  const job = {
    name, dir,
    description: String(raw.description || ''),
    schedule: String(raw.schedule || ''),
    timezone: String(raw.timezone || 'UTC'),
    enabled: raw.enabled === true,
    timeoutMinutes: Number(raw.timeout_minutes ?? 10),
    lockWaitMinutes: Number(raw.lock_wait_minutes ?? 20),
    command: raw.command ? String(raw.command) : null,
    tables: {},
    alerts: alertSettings(raw),
  };
  try { job.cron = parseCron(job.schedule); } catch (e) { problems.push(`schedule: ${e.message}`); }
  try { new Intl.DateTimeFormat('en-US', { timeZone: job.timezone }); } catch { problems.push(`timezone "${job.timezone}" is not an IANA zone (e.g. America/Toronto)`); }
  try { job.bot = resolveBot(raw.bot); } catch (e) { problems.push(`bot: ${e.message}`); }
  if (!(job.timeoutMinutes > 0 && job.timeoutMinutes <= 120)) problems.push('timeout_minutes must be 1–120');
  if (!raw.tables || typeof raw.tables !== 'object' || !Object.keys(raw.tables).length) problems.push('tables: declare at least one table');
  for (const [t, spec] of Object.entries(raw.tables || {})) {
    const s = { mode: 'replace', key: [], min_rows: 1, allow_schema_change: false, ...(spec || {}) };
    if (!TABLE.test(t)) problems.push(`table "${t}": use lowercase letters, digits, _`);
    if (!MODES.has(s.mode)) problems.push(`table "${t}": mode must be replace, append or upsert`);
    if (s.mode === 'upsert' && !(Array.isArray(s.key) && s.key.length)) problems.push(`table "${t}": upsert needs "key": ["column", ...]`);
    job.tables[t] = s;
  }
  job.script = job.command ? null : ['run.py', 'run.mjs', 'run.js', 'run.sh', 'run'].find((f) => fs.existsSync(path.join(dir, f)));
  if (!job.command && !job.script) problems.push('no script: add run.py, run.mjs, run.sh or an executable "run"');
  if (problems.length) throw new Error(`jobs/${name}:\n  - ${problems.join('\n  - ')}`);
  return job;
}

function jobNames() {
  try { return fs.readdirSync(JOBS, { withFileTypes: true }).filter((e) => e.isDirectory() && NAME.test(e.name)).map((e) => e.name).sort(); }
  catch { return []; }
}

const stateDir = (name) => { const d = path.join(STATE, name); fs.mkdirSync(path.join(d, 'runs'), { recursive: true }); return d; };
const readStatus = (name) => readJSON(path.join(STATE, name, 'status.json'), {});

function acquire(name) {
  const lock = path.join(stateDir(name), 'lock');
  try { fs.writeFileSync(lock, String(process.pid), { flag: 'wx' }); return () => fs.rmSync(lock, { force: true }); } catch {}
  const pid = Number(fs.readFileSync(lock, 'utf8'));
  try { process.kill(pid, 0); return null; } catch { fs.rmSync(lock, { force: true }); return acquire(name); }
}

function dotenv(file) {
  const env = {};
  try {
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
      const m = line.match(/^\s*([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*?)\s*$/);
      if (m) env[m[1]] = m[2].replace(/^(['"])(.*)\1$/, '$2');
    }
  } catch {}
  return env;
}

// ---------------------------------------------------------------- one run

async function duck() {
  return (await import(pathToFileURL(DUCKDB).href)).DuckDBInstance;
}

/** Run the job once. Returns the status object. log(line) gets every line. */
async function runJob(job, { dryRun = false, trigger = 'manual', echo = false } = {}) {
  const sdir = stateDir(job.name);
  const release = acquire(job.name);
  if (!release) throw new Error(`${job.name} is already running`);
  const started = stamp();
  const logFile = path.join(sdir, 'runs', `${started.replace(/[:.]/g, '-')}${dryRun ? '-dry' : ''}.log`);
  const logStream = fs.createWriteStream(logFile);
  const log = (line) => { logStream.write(`${line}\n`); if (echo) console.log(line); };
  const status = { ...readStatus(job.name), running: true, last_started: started, last_trigger: trigger };
  if (!dryRun) writeJSON(path.join(sdir, 'status.json'), status);
  const t0 = Date.now();
  let result = { ok: false };
  try {
    log(`# ${job.name} ${dryRun ? '(dry run) ' : ''}${started} trigger=${trigger} bot=${job.bot.name}`);
    const out = path.join(sdir, 'out');
    fs.rmSync(out, { recursive: true, force: true });
    fs.mkdirSync(out, { recursive: true });

    // 1. collect
    const [cmd, args] = job.command ? ['/bin/sh', ['-c', job.command]]
      : job.script.endsWith('.py') ? ['python3', [job.script]]
      : /\.m?js$/.test(job.script) ? [process.execPath, [job.script]]
      : job.script.endsWith('.sh') ? ['bash', [job.script]]
      : [`./${job.script}`, []];
    const env = {
      ...process.env, ...dotenv(path.join(job.dir, '.env')),
      WEBDATA_OUT: out, WEBDATA_JOB: job.name, WEBDATA_BOT: job.bot.name,
      WEBDATA_SNAPSHOT: job.bot.snapshot || '', WEBDATA_DRY_RUN: dryRun ? '1' : '',
    };
    log(`$ ${[cmd, ...args].join(' ')}   (cwd jobs/${job.name}, timeout ${job.timeoutMinutes}m)`);
    const code = await new Promise((resolve) => {
      const child = spawn(cmd, args, { cwd: job.dir, env, detached: true, stdio: ['ignore', 'pipe', 'pipe'] });
      const pipe = (stream, tag) => {
        let buf = '';
        stream.on('data', (d) => { buf += d; let i; while ((i = buf.indexOf('\n')) >= 0) { log(`${tag}${buf.slice(0, i)}`); buf = buf.slice(i + 1); } });
        stream.on('end', () => { if (buf) log(`${tag}${buf}`); });
      };
      pipe(child.stdout, '  ');
      pipe(child.stderr, '! ');
      let timedOut = false;
      const timer = setTimeout(() => { timedOut = true; log(`timeout after ${job.timeoutMinutes} minutes; killing`); try { process.kill(-child.pid, 'SIGKILL'); } catch {} }, job.timeoutMinutes * 60_000);
      child.on('error', (e) => { log(`could not start: ${e.message}`); clearTimeout(timer); resolve(-1); });
      child.on('close', (c, sig) => { clearTimeout(timer); resolve(timedOut ? 'timeout' : sig ? -1 : c); });
    });
    // A hung script is nearly always a source that stopped answering.
    if (code === 'timeout') throw temporary(`script timed out after ${job.timeoutMinutes} minutes (temporary); nothing written`);
    if (code === TEMPFAIL) throw temporary(`script exited with ${code} (temporary: its source couldn't be reached); nothing written`);
    if (code !== 0) throw new Error(`script exited with ${code}; nothing written`);

    // 2. stage + validate (no lock on the bot's database yet)
    const DuckDBInstance = await duck();
    const stageFile = path.join(sdir, 'stage.duckdb');
    fs.rmSync(stageFile, { force: true }); fs.rmSync(`${stageFile}.wal`, { force: true });
    const stage = await DuckDBInstance.create(stageFile);
    const sc = await stage.connect();
    const rows = (sql) => sc.runAndReadAll(sql).then((r) => r.getRowObjectsJson());
    const summary = {};
    try {
      for (const [t, spec] of Object.entries(job.tables)) {
        const file = FORMATS.map((f) => path.join(out, `${t}.${f}`)).find((f) => fs.existsSync(f));
        if (!file) throw new Error(`script did not write ${t}.{${FORMATS.join(',')}} to $WEBDATA_OUT; nothing written`);
        const ext = path.extname(file).slice(1);
        const reader = ext === 'parquet' ? 'read_parquet' : ext === 'csv' ? 'read_csv_auto' : 'read_json_auto';
        await sc.run(`CREATE TABLE ${q(t)} AS SELECT * FROM ${reader}(${lit(file)})`);
        const [{ n }] = await rows(`SELECT count(*)::INTEGER AS n FROM ${q(t)}`);
        if (n < spec.min_rows) throw new Error(`${t}: ${n} rows, fewer than min_rows ${spec.min_rows}; nothing written`);
        // An empty file ([] or no lines) has no columns of its own: an empty
        // result (allowed by min_rows 0) keeps the columns the table has now.
        if (n === 0) {
          const has = job.bot.snapshot && fs.existsSync(job.bot.snapshot);
          if (has) await sc.run(`ATTACH ${lit(job.bot.snapshot)} AS cur (READ_ONLY)`);
          try {
            const exists = has && (await rows(`SELECT 1 FROM duckdb_tables() WHERE database_name = 'cur' AND schema_name = 'main' AND table_name = ${lit(t)}`)).length > 0;
            if (!exists) throw new Error(`${t}: no rows, and no current table to take the columns from (the first run needs rows); nothing written`);
            await sc.run(`CREATE OR REPLACE TABLE ${q(t)} AS SELECT * FROM cur.main.${q(t)} LIMIT 0`);
          } finally { if (has) await sc.run('DETACH cur'); }
        }
        const cols = await rows(`SELECT column_name AS name, data_type AS type FROM duckdb_columns() WHERE table_name = ${lit(t)} AND database_name = current_database() ORDER BY column_index`);
        if (spec.mode === 'upsert') {
          for (const k of spec.key) if (!cols.some((c) => c.name === k)) throw new Error(`${t}: key column "${k}" not in output; nothing written`);
          const keyList = spec.key.map(q).join(', ');
          const [{ dups, nulls }] = await rows(`SELECT (SELECT count(*) FROM (SELECT ${keyList} FROM ${q(t)} GROUP BY ALL HAVING count(*) > 1))::INTEGER AS dups,
            (SELECT count(*) FROM ${q(t)} WHERE ${spec.key.map((k) => `${q(k)} IS NULL`).join(' OR ')})::INTEGER AS nulls`);
          if (dups || nulls) throw new Error(`${t}: key (${spec.key.join(', ')}) has ${dups} duplicate and ${nulls} null values; nothing written`);
        }
        summary[t] = { rows: n, columns: cols, mode: spec.mode, file: path.basename(file) };
        log(`staged ${t}: ${n} rows from ${path.basename(file)}${n === 0 ? ', columns from the current table' : ''} (${spec.mode}) · ${cols.map((c) => `${c.name} ${c.type}`).join(', ')}`);
      }
    } finally {
      sc.closeSync(); stage.closeSync();
    }

    // Compare with what the bot has now (from the published snapshot: no lock needed).
    if (job.bot.snapshot && fs.existsSync(job.bot.snapshot)) {
      const mem = await DuckDBInstance.create(':memory:');
      const mc = await mem.connect();
      try {
        await mc.run(`ATTACH ${lit(job.bot.snapshot)} AS cur (READ_ONLY)`);
        for (const [t, s] of Object.entries(summary)) {
          const cur = (await mc.runAndReadAll(`SELECT column_name AS name, data_type AS type FROM duckdb_columns() WHERE database_name = 'cur' AND schema_name = 'main' AND table_name = ${lit(t)} ORDER BY column_index`)).getRowObjectsJson();
          if (!cur.length) { log(`${t}: new table`); continue; }
          const sig = (cs) => cs.map((c) => `${c.name} ${c.type}`).join(', ');
          const [{ n }] = (await mc.runAndReadAll(`SELECT count(*)::INTEGER AS n FROM cur.main.${q(t)}`)).getRowObjectsJson();
          log(`${t}: currently ${n} rows`);
          if (sig(cur) !== sig(s.columns)) {
            const msg = `${t}: columns differ from the current table\n    now: ${sig(cur)}\n    new: ${sig(s.columns)}`;
            if (job.tables[t].mode !== 'replace' || !job.tables[t].allow_schema_change) {
              throw new Error(`${msg}\n  Reports and SQL may depend on the current columns. Make the script match them, or set "allow_schema_change": true (replace mode only). Nothing written.`);
            }
            log(`warning: ${msg} (allowed by allow_schema_change)`);
          }
        }
      } finally { mc.closeSync(); mem.closeSync(); }
    }

    if (dryRun) {
      log(`dry run OK: staged output is in ${rel(out)}/ and ${rel(stageFile)}; nothing written`);
      result = { ok: true, dry: true, tables: summary };
      return result;
    }

    // 3. apply: wait for the bot's database, then one short transaction.
    const deadline = Date.now() + job.lockWaitMinutes * 60_000;
    let db;
    for (let attempt = 1; ; attempt++) {
      try { db = await DuckDBInstance.create(job.bot.db); break; } catch (e) {
        if (!/lock/i.test(e.message)) throw new Error(`could not open ${job.bot.name}'s database: ${e.message.split('\n')[0]}; nothing written`);
        if (Date.now() > deadline) throw temporary(`${job.bot.name}'s database stayed in use by OpenMausBot for ${job.lockWaitMinutes}m (temporary); nothing written`);
        if (attempt === 1) log(`${job.bot.name}'s database is in use by OpenMausBot; waiting (up to ${job.lockWaitMinutes}m)`);
        await sleep(LOCK_RETRY_MS);
      }
    }
    const c = await db.connect();
    const ta = Date.now();
    try {
      await c.run(`ATTACH ${lit(stageFile)} AS stage (READ_ONLY)`);
      await c.run('BEGIN TRANSACTION');
      for (const [t, spec] of Object.entries(job.tables)) {
        const exists = (await c.runAndReadAll(`SELECT 1 FROM duckdb_tables() WHERE database_name = current_database() AND schema_name = 'main' AND table_name = ${lit(t)}`)).getRows().length > 0;
        const target = `main.${q(t)}`;
        if (spec.mode === 'replace' || !exists) {
          await c.run(`CREATE OR REPLACE TABLE ${target} AS SELECT * FROM stage.${q(t)}`);
        } else {
          if (spec.mode === 'upsert') {
            await c.run(`DELETE FROM ${target} AS cur USING stage.${q(t)} AS s WHERE ${spec.key.map((k) => `cur.${q(k)} = s.${q(k)}`).join(' AND ')}`);
          }
          await c.run(`INSERT INTO ${target} BY NAME SELECT * FROM stage.${q(t)}`);
        }
        const [{ n }] = (await c.runAndReadAll(`SELECT count(*)::INTEGER AS n FROM ${target}`)).getRowObjectsJson();
        summary[t].rows_after = n;
        log(`applied ${t}: ${spec.mode}${exists ? '' : ' (created)'} → ${n} rows`);
      }
      await c.run('COMMIT');
      await c.run('CHECKPOINT');
    } catch (e) {
      try { await c.run('ROLLBACK'); } catch {}
      throw new Error(`apply failed, rolled back: ${e.message.split('\n')[0]}`);
    } finally {
      c.closeSync(); db.closeSync();
    }
    log(`held ${job.bot.name}'s database for ${Date.now() - ta} ms`);
    result = { ok: true, tables: summary };
    return result;
  } catch (e) {
    log(`FAILED: ${e.message}`);
    result = { ok: false, error: e.message.split('\n')[0], kind: e.temporary ? 'temporary' : 'broken' };
    return result;
  } finally {
    const seconds = Math.round((Date.now() - t0) / 100) / 10;
    log(`# done in ${seconds}s: ${result.ok ? 'ok' : 'failed'}`);
    if (!result.dry) {
      Object.assign(status, { running: false, last_finished: stamp(), last_ok: result.ok, last_error: result.error ?? null,
        last_duration_s: seconds, last_log: rel(logFile) });
      delete status.notified_at;   // from before webdata-notify
      if (result.ok) {
        status.last_success = status.last_finished;
        status.last_rows = Object.fromEntries(Object.entries(result.tables).map(([t, s]) => [t, s.rows_after ?? s.rows]));
        Object.assign(status, { consecutive_failures: 0, broken_failures: 0, failing_since: null, failure_kind: null, checks: null });
      } else {
        status.consecutive_failures = (status.consecutive_failures || 0) + 1;
        status.broken_failures = result.kind === 'broken' ? (status.broken_failures || 0) + 1 : 0;
        status.failing_since ||= status.last_started;
        status.failure_kind = result.kind;
        status.checks = null;
        if (trigger === 'schedule') {
          // What webdata-notify (and the bot it alerts) needs to tell an outage from a real change.
          status.checks = await networkChecks(job);
          log(`checks: internet ${status.checks.internet}${status.checks.sources.map((c) => ` · ${c.host} ${c.result}`).join('')}`);
        }
      }
      writeJSON(path.join(sdir, 'status.json'), status);
    }
    await new Promise((r) => logStream.end(r));
    const logs = fs.readdirSync(path.join(sdir, 'runs')).sort();
    for (const old of logs.slice(0, Math.max(0, logs.length - KEEP_LOGS))) fs.rmSync(path.join(sdir, 'runs', old), { force: true });
    release();
  }
}

// ---------------------------------------------------------------- failures

const temporary = (message) => Object.assign(new Error(message), { temporary: true });

// Two well-known hosts, one by address (no DNS needed): if neither answers,
// it's this machine's connection, not the job's source.
const INTERNET_PROBES = ['https://1.1.1.1/', 'https://www.google.com/generate_204'];

function netError(e) {
  const code = e?.cause?.code || e?.code || e?.name;
  if (code === 'ENOTFOUND') return 'dns: no such name';
  if (code === 'EAI_AGAIN') return 'dns: no answer';
  if (code === 'ECONNREFUSED') return 'connection refused';
  if (code === 'ECONNRESET') return 'connection reset';
  if (code === 'TimeoutError' || code === 'ETIMEDOUT' || code === 'UND_ERR_CONNECT_TIMEOUT') return 'timed out';
  if (/CERT|SSL|TLS/.test(String(code))) return `TLS error (${code})`;
  return String(code || e?.message || e).slice(0, 80);
}

async function probe(url) {
  try {
    const r = await fetch(url, { method: 'HEAD', redirect: 'manual', signal: AbortSignal.timeout(8000),
      headers: { 'user-agent': 'webdata-job (+openmausbot)' } });
    return `answers (HTTP ${r.status})`;
  } catch (e) { return netError(e); }
}

/** The hosts a job reads from: its "sources", else the URLs written in its script. */
function sourceHosts(job) {
  const hosts = new Set();
  const add = (u) => {
    const h = /^(?:https?:\/\/)?([a-z0-9-]+(?:\.[a-z0-9-]+)+)/i.exec(String(u).trim())?.[1]?.toLowerCase();
    if (h && !/^(localhost|127\.|0\.|10\.|192\.168\.)/.test(h)) hosts.add(h);
  };
  job.alerts.sources.forEach(add);
  if (!hosts.size) {
    let text = job.command ?? '';
    try { if (job.script) text = fs.readFileSync(path.join(job.dir, job.script), 'utf8').slice(0, 200_000); } catch {}
    for (const m of text.matchAll(/https?:\/\/[a-z0-9.-]+/gi)) add(m[0]);
  }
  return [...hosts].slice(0, 5);
}

/** After a failed scheduled run: can this machine reach the internet, and the job's sources? */
async function networkChecks(job) {
  const internet = (await Promise.all(INTERNET_PROBES.map(probe))).some((r) => r.startsWith('answers')) ? 'ok' : 'down';
  const sources = await Promise.all(sourceHosts(job).map(async (host) => {
    try { await dns.lookup(host); } catch (e) { return { host, result: netError(e) }; }
    return { host, result: await probe(`https://${host}/`) };
  }));
  return { at: stamp(), internet, sources };
}

/** webdata-notify's view of a job's alerts, for list. */
function alertLine(job, notifyStatus) {
  // A mistake in the alert settings never stops the job; it shows here instead.
  if (!job.alerts.notify) return job.alerts.problems.length ? `alerts: PROBLEM in job.json: ${job.alerts.problems.join('; ')}` : 'alerts: off (add "notify_failure": "<bot>" to job.json)';
  const fresh = notifyStatus && Date.now() - Date.parse(notifyStatus.heartbeat_at) < 3 * HEARTBEAT_MS;
  if (!notifyStatus) return `alerts: → ${job.alerts.notify}, but webdata-notify isn't installed or hasn't run yet`;
  if (!fresh) return `alerts: → ${job.alerts.notify}, but webdata-notify isn't running (last seen ${ago(notifyStatus.heartbeat_at)})`;
  const s = notifyStatus.jobs?.[job.name];
  if (!s || s.notify !== job.alerts.notify) return `alerts: → ${job.alerts.notify} (webdata-notify picks this up within a minute)`;
  return `alerts: ${s.alerts}${s.state && s.state !== 'ok' ? ` · ${s.state}: ${s.detail}` : ''}`;
}

// ---------------------------------------------------------------- daemon

async function daemon() {
  console.log(`${stamp()} webdata-jobs: watching ${JOBS}`);
  const lastFired = new Map();
  const running = new Set();
  const broken = new Map();
  for (;;) {
    await sleep(60_000 - (Date.now() % 60_000) + 500);   // just after each minute boundary
    const now = new Date();
    const minute = Math.floor(now.getTime() / 60_000);
    for (const name of jobNames()) {
      let job;
      try { job = loadJob(name); broken.delete(name); } catch (e) {
        if (broken.get(name) !== e.message) { console.log(`${stamp()} ${name}: invalid, skipped\n${e.message}`); broken.set(name, e.message); }
        continue;
      }
      if (!job.enabled || running.has(name) || lastFired.get(name) === minute || !cronMatches(job.cron, now, job.timezone)) continue;
      lastFired.set(name, minute);
      running.add(name);
      const delay = Math.max(0, startOffset(name) * 1000 - (Date.now() % 60_000));
      sleep(delay)
        .then(() => {
          // Re-read: the job may have been edited or disabled while it waited.
          const current = loadJob(name);
          if (!current.enabled) return;
          console.log(`${stamp()} ${name}: starting`);
          return runJob(current, { trigger: 'schedule' })
            .then((r) => console.log(`${stamp()} ${name}: ${r.ok ? 'ok' : `FAILED: ${r.error}`}`));
        })
        .catch((e) => console.log(`${stamp()} ${name}: ${e.message}`))
        .finally(() => running.delete(name));
    }
  }
}

// ---------------------------------------------------------------- commands

function flags(args) {
  const out = { _: [] };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith('--')) {
      const k = a.slice(2);
      const v = args[i + 1] && !args[i + 1].startsWith('--') ? args[++i] : true;
      out[k] = out[k] === undefined ? v : [].concat(out[k], v);
    } else out._.push(a);
  }
  return out;
}

const SCRIPT_TEMPLATE = `#!/usr/bin/env python3
"""__DESCRIPTION__

Run by webdata-jobs on the schedule in job.json (python3 standard library only).

Contract: write one file per table declared in job.json into $WEBDATA_OUT,
named <table>.json (a JSON array of objects), .ndjson, .csv or .parquet,
using the same column names and types as the table already in the bot's
database. Exit non-zero on ANY problem: nothing is written to the bot's
database unless every declared table is produced and passes the checks.
Exit 75 (TEMPFAIL) when the source can't be reached, any other code when it
answered but not as expected: failure alerts treat the two differently.
Print a short progress line or two; it goes to the run log.
"""
import json
import os
import sys
import urllib.error
import urllib.request

OUT = os.environ["WEBDATA_OUT"]
TEMPFAIL = 75


def fetch_json(url, timeout=30):
    """GET url as JSON. Exits 75 when the source can't be reached or is overloaded
    (network errors, timeouts, HTTP 429/5xx); other errors fail the run as broken."""
    req = urllib.request.Request(url, headers={"User-Agent": "webdata-job (+openmausbot)"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.load(resp)
    except urllib.error.HTTPError as e:
        if e.code == 429 or e.code >= 500:
            print(f"temporary: {url} answered HTTP {e.code}", file=sys.stderr)
            sys.exit(TEMPFAIL)
        raise
    except (urllib.error.URLError, TimeoutError, ConnectionError) as e:
        print(f"temporary: {url} could not be reached: {e}", file=sys.stderr)
        sys.exit(TEMPFAIL)


def write_table(name, rows):
    if not rows:
        sys.exit(f"{name}: no rows collected")
    with open(os.path.join(OUT, f"{name}.json"), "w") as f:
        json.dump(rows, f)
    print(f"{name}: {len(rows)} rows")


def main():
__BODY__


if __name__ == "__main__":
    main()
`;

const commands = {
  list() {
    const names = jobNames();
    if (!names.length) { console.log(`no jobs yet (create one: webdata-job new <name> ...)`); return; }
    const notifyStatus = readJSON(NOTIFY_STATUS, null);
    for (const name of names) {
      const st = readStatus(name);
      let job;
      try { job = loadJob(name); } catch (e) { console.log(`${name}  INVALID: ${e.message.split('\n').slice(1).join('; ').trim()}`); continue; }
      const next = job.enabled ? nextRuns(job.cron, job.timezone, 1)[0] : null;
      const failed = `FAILED${st.failure_kind === 'temporary' ? ' (temporary)' : ''}${st.consecutive_failures > 1 ? ` ×${st.consecutive_failures}` : ''}`;
      const last = st.last_finished ? `${st.last_ok ? 'ok' : failed} ${ago(st.last_finished)}${!st.last_ok && st.failing_since ? `, failing for ${fmtDuration(Date.now() - Date.parse(st.failing_since))}` : ''}` : 'never run';
      console.log(`${name}  ${job.enabled ? 'enabled ' : 'DISABLED'}  "${job.schedule}" ${job.timezone}  bot ${job.bot.name} → ${Object.keys(job.tables).join(', ')}`);
      console.log(`    last: ${st.running ? 'RUNNING now' : last}${st.last_error && !st.last_ok ? ` (${st.last_error})` : ''}   next: ${next ? `${fmtTime(next, job.timezone)} +${startOffset(name)}s` : '-'}`);
      console.log(`    ${alertLine(job, notifyStatus)}`);
      if (job.description) console.log(`    ${job.description}`);
    }
  },

  show([name]) {
    const job = loadJob(name);
    console.log(fs.readFileSync(path.join(job.dir, 'job.json'), 'utf8').trim());
    console.log(`\nvalid · script: ${job.command ?? job.script} · bot database: ${job.bot.db}`);
    console.log(`next runs (${job.enabled ? 'enabled' : 'DISABLED: these would be the times'}), each starting ${startOffset(name)} s into the minute:`);
    for (const d of nextRuns(job.cron, job.timezone, 5)) console.log(`  ${fmtTime(d, job.timezone)}  (${d.toISOString().slice(0, 16)}Z)`);
  },

  async run([name], f) {
    const job = loadJob(name);
    const r = await runJob(job, { dryRun: Boolean(f['dry-run']), trigger: 'manual', echo: true });
    process.exitCode = r.ok ? 0 : 1;
  },

  logs([name], f) {
    loadJob(name);
    const dir = path.join(STATE, name, 'runs');
    const runs = fs.existsSync(dir) ? fs.readdirSync(dir).sort() : [];
    if (!runs.length) { console.log('no runs yet'); return; }
    if (f.all) { for (const r of runs) console.log(r); return; }
    process.stdout.write(fs.readFileSync(path.join(dir, runs.at(-1)), 'utf8'));
  },

  'notify-test'([name]) {
    const job = loadJob(name);
    if (!job.alerts.notify) throw new Error(`${name} has no "notify_failure" in job.json, so there is nothing to test`);
    // webdata-notify (root) reads this request as data and sends the test itself.
    fs.writeFileSync(path.join(stateDir(name), 'notify-test'), stamp() + '\n');
    console.log(`asked webdata-notify to send ${job.alerts.notify} a test alert for ${name} (within a minute; see: webdata-job list)`);
  },

  enable([name]) { setEnabled(name, true); },
  disable([name]) { setEnabled(name, false); },

  new([name], f) {
    if (!name || !NAME.test(name)) throw new Error('usage: webdata-job new <name> --bot <bot> --table <t>[:mode[:key,key]] ... --schedule "<cron>" [--tz <IANA>] [--description "..."]');
    const dir = path.join(JOBS, name);
    if (fs.existsSync(dir)) throw new Error(`jobs/${name} already exists`);
    const bot = resolveBot(f.bot);
    const tables = {};
    for (const spec of [].concat(f.table || [])) {
      const [t, mode = 'replace', key] = String(spec).split(':');
      tables[t] = { mode, ...(key ? { key: key.split(',') } : {}) };
    }
    if (!Object.keys(tables).length) throw new Error('give at least one --table <name>[:mode[:key,key]]');
    const schedule = String(f.schedule || '');
    parseCron(schedule);
    const job = { description: String(f.description || ''), bot: bot.name, schedule, timezone: String(f.tz || 'UTC'), enabled: false, timeout_minutes: 10, tables, notify_failure: bot.name };
    fs.mkdirSync(dir, { recursive: true });
    writeJSON(path.join(dir, 'job.json'), job);
    const body = Object.keys(tables).map((t) => `    ${t} = []  # TODO: collect rows (dicts) for ${t}\n    write_table("${t}", ${t})`).join('\n');
    const script = path.join(dir, 'run.py');
    fs.writeFileSync(script, SCRIPT_TEMPLATE.replace('__DESCRIPTION__', job.description || name).replace('__BODY__', body));
    fs.chmodSync(script, 0o755);
    loadJob(name);
    console.log(`created jobs/${name}/ (job.json, run.py) DISABLED.\nNext: write run.py, then: webdata-job run ${name} --dry-run`);
  },

  daemon,
};

function setEnabled(name, on) {
  const job = loadJob(name);
  const file = path.join(job.dir, 'job.json');
  const raw = readJSON(file, {});
  raw.enabled = on;
  writeJSON(file, raw);
  const next = on ? nextRuns(job.cron, job.timezone, 1)[0] : null;
  console.log(`${name} ${on ? `enabled; next run ${fmtTime(next, job.timezone)}` : 'disabled'}`);
  if (on && !readStatus(name).last_success) console.log(`warning: ${name} has never completed a real run; test it with: webdata-job run ${name}`);
}

const [cmd, ...rest] = process.argv.slice(2);
const f = flags(rest);
if (!commands[cmd]) {
  process.stdout.write(fs.readFileSync(fileURLToPath(import.meta.url), 'utf8').split('\n').slice(1, 24).map((l) => l.replace(/^\/\/ ?/, '')).join('\n') + '\n');
  process.exit(cmd ? 2 : 0);
}
try {
  await commands[cmd](f._, f);
} catch (e) {
  console.error(e.message);
  process.exit(1);
}
