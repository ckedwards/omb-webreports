#!/usr/bin/env node
// webdata-gate: the site's front door (webdata-gate.service, as the
// omb-webreports-gate user). tailscale serve (and Funnel, when it's on) send
// every request here; Apache serves the files on 127.0.0.1 only.
//
// Each request is let through only if every database it reveals is public, or
// the visitor has that database's cookie (bin/_access.mjs):
//   /data/<db>.duckdb, /data/<db>.<ext>, /data/<db>/…   the database <db>
//   /reports/<slug>/…                                    the databases its report.json lists
//   /reports/index.json, /data/catalog.json              filtered to what this visitor may see
//   everything else (/, /lib/, the gallery, icons)       public: the shared site, nothing private
//
// A private page (asked for by a browser) gets a password form at its own
// address, so it also works inside an iPhone home-screen app, whose cookies
// are its own. The right password sets a signed cookie for that database for a
// year: HttpOnly, SameSite=Lax, Secure when the site is HTTPS. Anything else
// gets a bare 401. Wrong passwords slow down per database: tailscale serve
// sends everyone from one address, so there's no per-visitor limit to use.
//
// The path is normalized here and Apache is asked for exactly that path, so
// the gate and Apache never disagree about which file a request means.

import crypto from 'node:crypto';
import fs from 'node:fs';
import http from 'node:http';
import path from 'node:path';

import { ROOT, LOCAL_URL, GATE_PORT, SITE_URL, ACCESS_DEFAULT } from './_config.mjs';
import { accessOf, reportDatabases, verifyPassword, cookieName, makeToken, tokenValid, NAME, COOKIE_DAYS } from './_access.mjs';

const APACHE = new URL(process.env.WEBDATA_GATE_UPSTREAM || LOCAL_URL);
const PORT = Number(process.env.WEBDATA_GATE_PORT || GATE_PORT);
const KEY_FILE = process.env.WEBDATA_GATE_KEY || path.join(process.env.STATE_DIRECTORY || '/var/lib/omb-webreports-gate', 'key');
const SECURE = SITE_URL.startsWith('https:');
const TEMPLATE = fs.readFileSync(path.join(ROOT, 'templates', 'login.html'), 'utf8');
const HOP = ['connection', 'keep-alive', 'proxy-connection', 'transfer-encoding', 'upgrade', 'te', 'trailer', 'proxy-authorization', 'proxy-authenticate'];
const FILTERED = new Set(['/reports/index.json', '/data/catalog.json']);
const MAX_FILTERED = 4 * 1024 * 1024;

const log = (line) => console.log(`${new Date().toISOString()} ${line}`);

function loadKey() {
  try { const k = fs.readFileSync(KEY_FILE); if (k.length >= 32) return k; } catch {}
  const k = crypto.randomBytes(32);
  fs.mkdirSync(path.dirname(KEY_FILE), { recursive: true, mode: 0o700 });
  fs.writeFileSync(KEY_FILE, k, { mode: 0o600 });
  return k;
}
const KEY = loadKey();

// ---------------------------------------------------------------- paths

class HttpError extends Error { constructor(status, msg) { super(msg); this.status = status; } }

/** A clean path: decoded, no "." or ".." segments, no doubled slashes; refuses tricks. */
function normalize(raw) {
  if (raw.length > 2048) throw new HttpError(414, 'path too long');
  if (/%2f|%5c|%00/i.test(raw)) throw new HttpError(400, 'bad path');
  let p;
  try { p = decodeURIComponent(raw); } catch { throw new HttpError(400, 'bad path'); }
  if (!p.startsWith('/') || /[\0\\]/.test(p)) throw new HttpError(400, 'bad path');
  const parts = p.split('/').filter((s) => s !== '');
  if (parts.some((s) => s === '.' || s === '..')) throw new HttpError(400, 'bad path');
  return '/' + parts.join('/') + (parts.length && p.endsWith('/') ? '/' : '');
}
const encodePath = (p) => p.split('/').map(encodeURIComponent).join('/');

/**
 * What a path needs: { databases: [...] } — every one must be allowed — or
 * { closed: true } for a report that lists no databases on a private-by-default site.
 */
function requirement(p) {
  let m = /^\/data\/([^/]+)(?:\/|$)/.exec(p);
  if (m) {
    if (m[1] === 'catalog.json') return { databases: [] };
    return { databases: [m[1].split('.')[0]] };
  }
  m = /^\/reports\/([^/]+)(?:\/|$)/.exec(p);
  if (m && m[1] !== '_gallery' && m[1] !== 'index.json') {
    const r = reportDatabases(m[1]);
    if (!r) return { databases: [] };                     // no such report: Apache's 404
    if (!r.databases.length) return ACCESS_DEFAULT === 'private' ? { closed: true } : { databases: [] };
    return { databases: r.databases };
  }
  return { databases: [] };
}

// ---------------------------------------------------------------- cookies and access

function cookies(req) {
  const out = {};
  for (const part of String(req.headers.cookie ?? '').split(';')) {
    const i = part.indexOf('=');
    if (i > 0) out[part.slice(0, i).trim()] = part.slice(i + 1).trim();
  }
  return out;
}

function allowed(jar, db) {
  const a = accessOf(db);
  if (a.access === 'public') return true;
  return !!a.password && tokenValid(KEY, db, a.password, jar[cookieName(db)]);
}

/** The databases of a requirement this visitor may not see yet (null: closed for good). */
function missing(req, need) {
  if (need.closed) return null;
  const jar = cookies(req);
  return need.databases.filter((db) => !allowed(jar, db));
}

function reportVisible(jar, slug) {
  const r = reportDatabases(slug);
  if (!r) return false;
  if (!r.databases.length) return ACCESS_DEFAULT === 'public';
  return r.databases.every((db) => allowed(jar, db));
}

// ---------------------------------------------------------------- responses

const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

function send(res, status, type, body, extra = {}) {
  const buf = Buffer.from(body);
  res.writeHead(status, { 'content-type': type, 'content-length': buf.length, 'cache-control': 'no-store',
    'x-content-type-options': 'nosniff', 'referrer-policy': 'no-referrer', ...extra });
  res.end(res.req.method === 'HEAD' ? undefined : buf);
}

const wantsPage = (req) => req.method === 'GET' || req.method === 'POST'
  ? req.headers['sec-fetch-mode'] === 'navigate' || /text\/html/.test(String(req.headers.accept ?? ''))
  : false;

function loginPage(res, status, action, step, total, error = '') {
  const html = TEMPLATE
    .replaceAll('{{ACTION}}', esc(action))
    .replaceAll('{{STEP_INDEX}}', String(step))
    .replaceAll('{{STEP}}', total > 1 ? esc(`Password ${step + 1} of ${total}. `) : '')
    .replaceAll('{{ERROR}}', esc(error));
  send(res, status, 'text/html; charset=utf-8', html, { 'x-frame-options': 'DENY' });
}

function deny(req, res, p, search, need, miss) {
  if (!wantsPage(req)) return send(res, miss === null ? 403 : 401, 'text/plain; charset=utf-8', 'private\n');
  const action = encodePath(p) + search;
  const withPassword = (miss ?? []).filter((db) => accessOf(db).password);
  if (miss === null || withPassword.length < (miss ?? []).length) {
    return send(res, 403, 'text/html; charset=utf-8', TEMPLATE
      .replace(/<form[\s\S]*<\/form>/, '<p>This page is private, and no password has been set for it yet.</p>')
      .replace(/<p>\{\{STEP\}\}[^<]*<\/p>/, ''));
  }
  const step = need.databases.indexOf(withPassword[0]);
  loginPage(res, 401, action, step, need.databases.length);
}

// ---------------------------------------------------------------- login

// Per database: failures in a row, and when the next try is allowed.
const tries = new Map();
const FREE_TRIES = 5;

function readForm(req, max = 4096) {
  return new Promise((resolve, reject) => {
    if (!/^application\/x-www-form-urlencoded/.test(String(req.headers['content-type'] ?? ''))) return reject(new HttpError(415, 'form expected'));
    let size = 0; const chunks = [];
    req.on('data', (c) => { size += c.length; if (size > max) { reject(new HttpError(413, 'too large')); req.destroy(); } else chunks.push(c); });
    req.on('end', () => resolve(new URLSearchParams(Buffer.concat(chunks).toString('utf8'))));
    req.on('error', reject);
  });
}

async function login(req, res, p, search) {
  const form = await readForm(req);
  const need = requirement(p);
  const action = encodePath(p) + search;
  if (need.closed || !need.databases.length) return send(res, 303, 'text/plain', '', { location: action });
  const step = Number(form.get('step'));
  const db = need.databases[Number.isInteger(step) ? step : -1];
  const a = db && accessOf(db);
  if (!a || !a.password) return send(res, 303, 'text/plain', '', { location: action });
  const t = tries.get(db) ?? { fails: 0, until: 0, busy: false };
  tries.set(db, t);
  const now = Date.now();
  if (t.busy || now < t.until) {
    const wait = Math.max(1, Math.ceil((t.until - now) / 1000));
    return loginPage(res, 429, action, step, need.databases.length, `Too many tries. Wait ${wait} s and try again.`);
  }
  t.busy = true;
  let ok = false;
  try { ok = await verifyPassword(form.get('password') ?? '', a.password); } finally { t.busy = false; }
  if (!ok) {
    t.fails += 1;
    if (t.fails >= FREE_TRIES) t.until = Date.now() + Math.min(60_000, 1000 * 2 ** (t.fails - FREE_TRIES));
    log(`wrong password for ${db} (${t.fails} in a row)`);
    return loginPage(res, 401, action, step, need.databases.length, 'That password isn’t right.');
  }
  tries.delete(db);
  const cookie = [`${cookieName(db)}=${makeToken(KEY, db, a.password)}`, 'Path=/', `Max-Age=${COOKIE_DAYS * 86400}`,
    'HttpOnly', 'SameSite=Lax', ...(SECURE ? ['Secure'] : [])].join('; ');
  log(`signed in to ${db}`);
  send(res, 303, 'text/plain', '', { location: action, 'set-cookie': cookie });
}

function logout(req, res) {
  const out = Object.keys(cookies(req)).filter((k) => k.startsWith('omb_'))
    .map((k) => `${k}=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax${SECURE ? '; Secure' : ''}`);
  send(res, 303, 'text/plain', '', { location: '/', 'set-cookie': out });
}

// ---------------------------------------------------------------- to Apache

function upstreamHeaders(req) {
  const h = { ...req.headers };
  for (const k of [...HOP, 'cookie']) delete h[k];
  const xff = req.headers['x-forwarded-for'];
  h['x-forwarded-for'] = xff ? `${xff}, ${req.socket.remoteAddress}` : req.socket.remoteAddress;
  return h;
}

/** Apache's absolute redirects name its own scheme; keep only the path. */
function fixLocation(h) {
  if (!h.location) return;
  try { const u = new URL(h.location, 'http://x'); if (u.host !== 'x') h.location = u.pathname + u.search; } catch {}
}

function proxy(req, res, p, search, isPrivate) {
  const up = http.request({ host: APACHE.hostname, port: APACHE.port, method: req.method, path: encodePath(p) + search, headers: upstreamHeaders(req) }, (ur) => {
    const h = { ...ur.headers };
    for (const k of HOP) delete h[k];
    fixLocation(h);
    if (isPrivate) { h['cache-control'] = 'private, no-cache'; h.vary = h.vary ? `${h.vary}, Cookie` : 'Cookie'; }
    res.writeHead(ur.statusCode, h);
    ur.pipe(res);
  });
  up.on('error', (e) => { log(`apache: ${e.message}`); if (!res.headersSent) send(res, 502, 'text/plain', 'the site is restarting; try again\n'); else res.destroy(); });
  res.on('close', () => up.destroy());
  up.end();
}

/** index.json and catalog.json, with only what this visitor may see. */
function filtered(req, res, p) {
  const headers = upstreamHeaders(req);
  delete headers['if-none-match']; delete headers['if-modified-since']; delete headers.range;
  headers['accept-encoding'] = 'identity';
  const up = http.request({ host: APACHE.hostname, port: APACHE.port, method: 'GET', path: p, headers }, (ur) => {
    const chunks = []; let size = 0;
    ur.on('data', (c) => { size += c.length; if (size <= MAX_FILTERED) chunks.push(c); });
    ur.on('end', () => {
      if (ur.statusCode !== 200 || size > MAX_FILTERED) return send(res, ur.statusCode === 200 ? 502 : ur.statusCode, 'text/plain', `${ur.statusCode}\n`);
      let doc;
      try { doc = JSON.parse(Buffer.concat(chunks).toString('utf8')); } catch { return send(res, 502, 'text/plain', 'bad json\n'); }
      const jar = cookies(req);
      if (p === '/reports/index.json' && Array.isArray(doc.reports)) doc.reports = doc.reports.filter((r) => reportVisible(jar, String(r?.slug ?? '')));
      if (p === '/data/catalog.json' && Array.isArray(doc.databases)) doc.databases = doc.databases.filter((d) => NAME.test(String(d?.name ?? '')) && allowed(jar, d.name));
      const body = JSON.stringify(doc, null, 2) + '\n';
      const etag = `"g${crypto.createHash('sha256').update(body).digest('base64url').slice(0, 22)}"`;
      const common = { etag, 'cache-control': 'private, no-cache', vary: 'Cookie' };
      if (req.headers['if-none-match'] === etag) { res.writeHead(304, common); return res.end(); }
      send(res, 200, 'application/json; charset=utf-8', body, common);
    });
  });
  up.on('error', (e) => { log(`apache: ${e.message}`); if (!res.headersSent) send(res, 502, 'text/plain', 'the site is restarting; try again\n'); });
  up.end();
}

// ---------------------------------------------------------------- the server

async function handle(req, res) {
  const raw = String(req.url ?? '/');
  const q = raw.indexOf('?');
  const search = q >= 0 ? raw.slice(q) : '';
  const p = normalize(q >= 0 ? raw.slice(0, q) : raw);
  if (req.method === 'POST') return login(req, res, p, search);
  if (req.method !== 'GET' && req.method !== 'HEAD') return send(res, 405, 'text/plain', 'GET or HEAD\n', { allow: 'GET, HEAD' });
  if (p === '/_gate/logout') return logout(req, res);
  if (FILTERED.has(p)) return filtered(req, res, p);
  const need = requirement(p);
  const miss = missing(req, need);
  if (miss === null || miss.length) return deny(req, res, p, search, need, miss);
  const isPrivate = need.databases.some((db) => accessOf(db).access === 'private');
  return proxy(req, res, p, search, isPrivate);
}

const server = http.createServer((req, res) => {
  handle(req, res).catch((e) => {
    if (!(e instanceof HttpError)) log(`error: ${e.stack || e}`);
    if (!res.headersSent) send(res, e.status || 500, 'text/plain', `${e.status ? e.message : 'error'}\n`);
  });
});
server.requestTimeout = 30_000;
server.headersTimeout = 15_000;
server.keepAliveTimeout = 5_000;
server.listen(PORT, '127.0.0.1', () => log(`webdata-gate on 127.0.0.1:${PORT} → Apache ${APACHE.host}; databases without a setting are ${ACCESS_DEFAULT}`));
