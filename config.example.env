# omb-webreports configuration. Copy to config.env and edit:
#
#   cp config.example.env config.env
#
# config.env is read by admin/install.sh (as root) and by every tool in bin/.
# It is git-ignored: it describes this machine. Re-run
# `sudo bash admin/install.sh` after changing it.

# The Linux user that runs OpenMausBot (and owns this checkout). The sync and
# jobs services run as this user. Default: the user who ran sudo.
WEBREPORTS_OWNER=

# Where Apache listens. Use your Tailscale IPv4 address (`tailscale ip -4`) so
# only your tailnet can reach it. Default: the Tailscale IPv4 address.
LISTEN_IP=
LISTEN_PORT=8080

# Who may connect (Apache `Require ip`). Default: Tailscale's address ranges.
ALLOWED_NETS="100.64.0.0/10 fd7a:115c:a1e0::/48"

# The URL people (and bots) open the site with. Recommended: HTTPS through
# `tailscale serve --bg --https=8443 http://<LISTEN_IP>:<LISTEN_PORT>`, which
# gives https://<machine>.<tailnet>.ts.net:8443. Default: http://LISTEN_IP:LISTEN_PORT
SITE_URL=

# OpenMausBot's data directory (bots, their DuckDB databases).
# Default: ~WEBREPORTS_OWNER/.openmausbot
OMB_DATA_DIR=

# Global node_modules holding the native modules OpenMausBot needs and this
# project reuses: @duckdb/node-api and @resvg/resvg-js (see docs/setup.md).
NODE_MODULES_DIR=/usr/lib/node_modules

# How OpenMausBot treats requests from this machine that have no login.
#   service  isolated (recommended): they can't administer OpenMausBot, so bots'
#            shells, which run here, can't change its settings, skills or
#            permissions through its local API. webdata-skills uses its own
#            session instead (root-only; its commands then run with sudo), and
#            `openmausbot pair` stops working: pair devices in the app
#            (Settings → Remote access).
#   owner    OpenMausBot's default on a self-hosted server: they act as you.
#   (empty)  leave OpenMausBot's own setting alone.
# Applied by admin/install.sh (a systemd drop-in for openmausbot). See docs/architecture.md.
OMB_LOOPBACK_TRUST=service

# The DuckDB-WASM build reports run in the browser. It must contain the same
# DuckDB engine as OpenMausBot's @duckdb/node-api. Don't edit by hand:
# admin/openmausbot-upgrade.sh finds the matching build and sets it here.
# Empty: the default in bin/_config.mjs (matches the tested OpenMausBot release).
DUCKDB_WASM_VERSION=
