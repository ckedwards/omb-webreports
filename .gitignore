# Generated on the installed copy by webdata-sync --platform (the installer runs
# it); appears here only if you run it in a checkout.
/webroot/manifest.webmanifest
/webroot/icon-*.png

# Not part of the program: reports and published data live in DATA_DIR
# (/var/lib/omb-webreports) on the machine. Only the design gallery ships.
/webroot/reports/*
!/webroot/reports/_gallery/
/webroot/data/

# Python bytecode
__pycache__/

# wrangler for bin/webdata-deploy (npm ci in deploy/; the installer does it for the installed copy)
/deploy/node_modules/
