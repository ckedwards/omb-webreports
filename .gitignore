# This machine's settings (see config.example.env)
/config.env
/sync.json

# Generated by webdata-sync
/.state/
/webroot/data/
/webroot/reports/index.json
/webroot/manifest.webmanifest
/webroot/icon-*.png
/webroot/reports/*/manifest.webmanifest
/webroot/reports/*/icon-*.png

# Your content: reports and data jobs belong to your bots, not to the
# platform. Only the design gallery ships; examples/ holds a reference report.
/webroot/reports/*
!/webroot/reports/_gallery/
/jobs/*
!/jobs/.gitkeep

# Python bytecode
__pycache__/
